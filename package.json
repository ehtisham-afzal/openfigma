{
  "name": "openfigma",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source Figma UI3 starter template built with React 19, TypeScript, Tailwind CSS v4, and UI SDK — featuring an infinite design canvas, Auto Layout, Bézier Pen & Pencil tools, Design Variables, Dev Mode, and a reusable Figma UI3 component library.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "figma",
    "figma-ui3",
    "design-tool",
    "canvas-editor",
    "vector-editor",
    "auto-layout",
    "react",
    "typescript",
    "tailwindcss",
    "ui-sdk",
    "starter-template",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ehtisham-afzal/openfigma.git"
  },
  "homepage": "https://openfigma.vercel.app/",
  "bugs": {
    "url": "https://github.com/ehtisham-afzal/openfigma/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@ui-sdk/core": "latest",
    "@ui-sdk/react": "latest",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.1"
  }
}
